<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="chama_archive.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="3924"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="chat_fts" custom_title="0" dock_id="1" table="4,8:mainchat_fts"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000012700ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">-- 2. 配信ごとの内訳(タイトル・YouTube ID・チャット数・文字起こし数がちゃんと入っているか)
SELECT
  s.stream_key,
  s.stream_date,
  s.title,
  s.youtube_video_id,
  (SELECT COUNT(*) FROM chat_messages c WHERE c.stream_key = s.stream_key) AS chat_count,
  (SELECT COUNT(*) FROM transcript_segments t WHERE t.stream_key = s.stream_key) AS transcript_count
FROM streams s
ORDER BY s.stream_key;</sql><current_tab id="0"/></tab_sql></sqlb_project>
